    "import numpy as np\n",
    "import random\n",
    "from qiskit import QuantumCircuit, transpile, ClassicalRegister\n",
    "from qiskit_aer import AerSimulator\n",
    "from qiskit.circuit.library import SXGate, RYGate, CPhaseGate, iSwapGate\n",
    "from qiskit.quantum_info import Statevector\n",
    "from qiskit_ibm_runtime import QiskitRuntimeService, SamplerV2 as Sampler \n",
    "\n",
    "# --- Verify Qiskit Version ---\n",
    "import qiskit\n",
    "print(f\"Qiskit version installed: {qiskit.__version__}\")\n",
    "\n",
    "# Check qiskit-ibm-runtime version\n",
    "import qiskit_ibm_runtime\n",
    "print(f\"Qiskit IBM Runtime version installed: {qiskit_ibm_runtime.__version__}\")\n",
    "\n",
    "\n",
    "def create_random_circuit(num_qubits, depth, single_qubit_gate_options, entangling_gate_func):\n",
    "    qc = QuantumCircuit(num_qubits)\n",
    "\n",
    "    for cycle in range(depth):\n",
    "        for i in range(num_qubits):\n",
    "            gate_choice = random.choice(single_qubit_gate_options)\n",
    "            if isinstance(gate_choice, SXGate):\n",
    "                qc.sx(i)\n",
    "            elif isinstance(gate_choice, RYGate):\n",
    "                qc.ry(np.pi / 2, i)\n",
    "            elif gate_choice == 'random_u3':\n",
    "                qc.u(random.uniform(0, 2*np.pi), random.uniform(0, 2*np.pi), random.uniform(0, 2*np.pi), i)\n",
    "        qc.barrier()\n",
    "\n",
    "        if cycle % 2 == 0:\n",
    "            for i in range(0, num_qubits - 1, 2):\n",
    "                entangling_gate_func(qc, i, i + 1)\n",
    "        else:\n",
    "            for i in range(1, num_qubits - 1, 2):\n",
    "                entangling_gate_func(qc, i, i + 1)\n",
    "        qc.barrier()\n",
    "    return qc\n",
    "\n",
    "def sycamore_entangling_gate(qc, q1, q2):\n",
    "    qc.iswap(q1, q2)\n",
    "    qc.append(CPhaseGate(np.pi / 3), [q1, q2])\n",
    "\n",
    "def calculate_xeb_fidelity(ideal_probabilities, experimental_counts, num_shots):\n",
    "    if not experimental_counts or num_shots == 0:\n",
    "        print(\"Warning: No experimental counts or zero shots provided. Cannot calculate XEB fidelity.\")\n",
    "        return -1.0\n",
    "    \n",
    "    num_qubits = len(list(ideal_probabilities.keys())[0]) if ideal_probabilities else 0\n",
    "    if num_qubits == 0:\n",
    "        print(\"Warning: No ideal probabilities provided. Cannot calculate XEB fidelity.\")\n",
    "        return -1.0\n",
    "\n",
    "    sum_of_weighted_ideal_probs = 0.0\n",
    "    for bitstring, count in experimental_counts.items():\n",
    "        if bitstring in ideal_probabilities:\n",
    "            sum_of_weighted_ideal_probs += ideal_probabilities[bitstring] * (count / num_shots)\n",
    "    \n",
    "    xeb_fidelity = (2**num_qubits) * sum_of_weighted_ideal_probs - 1\n",
    "    return xeb_fidelity\n",
    "\n",
    "# --- Main Execution Section ---\n",
    "print(\"Welcome to the Qiskit Quantum Supremacy Experiment Simulator!\")\n",
    "print(\"This code generates a pseudo-random quantum circuit, simulates it locally,\")\n",
    "print(\"and optionally executes it on a real IBM Quantum computer (smaller than Sycamore).\")\n",
    "print(\"It then calculates the Cross-Entropy Benchmarking (XEB) fidelity.\")\n",
    "\n",
    "# --- Define Parameters for the Circuit and Simulation ---\n",
    "N_QUBITS = 5 \n",
    "DEPTH = 3    \n",
    "NUM_SHOTS = 2048 \n",
    "\n",
    "print(f\"\\n--- Simulation Parameters ---\")\n",
    "print(f\"Number of Qubits: {N_QUBITS}\")\n",
    "print(f\"Circuit Depth (cycles): {DEPTH}\")\n",
    "print(f\"Number of Shots for Measurement: {NUM_SHOTS}\")\n",
    "\n",
    "single_qubit_gate_options = [SXGate(), RYGate(np.pi / 2), 'random_u3']\n",
    "\n",
    "# --- Circuit Generation ---\n",
    "print(\"\\n--- Generating Pseudo-Random Quantum Circuit ---\")\n",
    "sycamore_qc_unmeasured = create_random_circuit(N_QUBITS, DEPTH, single_qubit_gate_options, sycamore_entangling_gate)\n",
    "print(\"Circuit generated successfully (without measurements).\")\n",
    "print(\"\\n--- Visual Representation of the Circuit (Unmeasured) ---\")\n",
    "print(sycamore_qc_unmeasured.draw(\"text\"))\n",
    "\n",
    "# --- Local Simulation (Ideal) for XEB Fidelity Calculation using Statevector ---\n",
    "print(\"\\n--- Local Simulation (Ideal) for XEB ---\")\n",
    "print(\"Calculating ideal probabilities from the statevector using the Statevector constructor.\")\n",
    "ideal_statevector = Statevector(sycamore_qc_unmeasured)\n",
    "ideal_probabilities = ideal_statevector.probabilities_dict()\n",
    "print(\"Ideal simulation complete. Ideal probabilities obtained for XEB calculation.\")\n",
    "print(f\"Sample Ideal Probabilities (first 5): {dict(list(ideal_probabilities.items())[:5])}...\")\n",
    "\n",
    "# --- Prepare Circuit for Noisy/Counts Simulation (with measurements) ---\n",
    "print(\"\\n--- Preparing Circuit for Noisy Simulation (with measurements) ---\")\n",
    "sycamore_qc_measured = sycamore_qc_unmeasured.copy()\n",
    "sycamore_qc_measured.add_register(ClassicalRegister(N_QUBITS, 'c'))\n",
    "sycamore_qc_measured.measure(range(N_QUBITS), range(N_QUBITS))\n",
    "print(\"Circuit with measurements prepared for noisy simulation.\")\n",
    "print(\"\\n--- Visual Representation of the Circuit (Measured) ---\")\n",
    "print(sycamore_qc_measured.draw(output=\"text\"))\n",
    "\n",
    "# --- Local Simulation (Noisy/Counts) for Comparison ---\n",
    "print(\"\\n--- Local Simulation (Noisy/Counts) ---\")\n",
    "print(\"Simulating the circuit on AerSimulator (default method) to get measurement counts (mimicking noisy hardware).\")\n",
    "noisy_simulator = AerSimulator()\n",
    "transpiled_noisy_qc = transpile(sycamore_qc_measured, noisy_simulator)\n",
    "job_noisy = noisy_simulator.run(transpiled_noisy_qc, shots=NUM_SHOTS)\n",
    "result_noisy = job_noisy.result()\n",
    "counts_noisy_sim = result_noisy.get_counts(transpiled_noisy_qc)\n",
    "print(\"Noisy simulation complete.\")\n",
    "print(f\"Noisy Simulator Counts (first 5): {dict(list(counts_noisy_sim.items())[:5])}...\")\n",
    "\n",
    "# --- Calculate XEB Fidelity for Local Noisy Simulation ---\n",
    "xeb_noisy_sim = calculate_xeb_fidelity(ideal_probabilities, counts_noisy_sim, NUM_SHOTS)\n",
    "print(f\"\\n--- Cross-Entropy Benchmarking (XEB) Fidelity (Noisy Simulator) ---\")\n",
    "print(f\"XEB Fidelity (Noisy Simulator): {xeb_noisy_sim:.4f}\")\n",
    "if xeb_noisy_sim > 1.0 or xeb_noisy_sim < -1.0:\n",
    "    print(f\"⚠️ Warning: Noisy Simulator XEB fidelity out of bounds: {xeb_noisy_sim:.4f}\")\n",
    "\n",
    "#################\n",
    "#################\n",
    "# Execute on a Real IBM Quantum Computer #\n",
    "#################\n",
    "#################\n",
    "\n",
    "print(\"\\n--- IBM Quantum Hardware Execution (Optional) ---\")\n",
    "print(\"To run this circuit on a real IBM Quantum computer, you need an IBM Quantum account.\")\n",
    "print(\"1. Visit https://quantum.ibm.com/ and create an account if you don't have one.\")\n",
    "print(\"2. Copy your API token from your account's 'My Account' page.\")\n",
    "print(\"3. In a separate Python environment or script (before running this code),\")\n",
    "print(\"   execute: `QiskitRuntimeService.save_account(channel='ibm_quantum', token='YOUR_API_TOKEN')`\")\n",
    "print(\"   This saves your credentials locally. (Make sure you have `qiskit-ibm-runtime` installed: `pip install qiskit-ibm-runtime`)\")\n",
    "print(\"\\n**IMPORTANT: The free 'Open Plan' on IBM Quantum does NOT support 'Session' mode.**\")\n",
    "print(\"This code will now run in 'Job' mode, which is supported by the free tier.\")\n",
    "\n",
    "\n",
    "run_on_hardware = input(\"\\nDo you want to run this circuit on a real IBM Quantum computer? (yes/no): \").lower()\n",
    "\n",
    "if run_on_hardware == 'yes':\n",
    "    try:\n",
    "        # IMPORTANT: Updated channel for QiskitRuntimeService due to deprecation\n",
    "        # For security, load these from environment variables or a config file in real applications.\n",
    "        MY_API_TOKEN = \"YOUR_NEW_API_TOKEN_HERE\" # <<< REPLACE THIS WITH YOUR ACTUAL, NEW API TOKEN\n",
    "        MY_INSTANCE_CRN = \"YOUR_REVERIFIED_INSTANCE_CRN_HERE\" # <<< REPLACE THIS WITH YOUR ACTUAL, RE-VERIFIED INSTANCE CRN\n",
    "\n",
    "        service = QiskitRuntimeService(\n",
    "            channel='ibm_cloud',\n",
    "            token=MY_API_TOKEN,\n",
    "            instance=MY_INSTANCE_CRN\n",
    "        )\n",
    "        \n",
    "        print(\"\\nAvailable IBM Quantum backends:\")\n",
    "        # Consider a smaller backend for the free tier, like a 7-qubit device\n",
    "        # You can use `service.backends()` to see what's available\n",
    "        # You might need to pick a backend that supports your number of qubits (N_QUBITS)\n",
    "        backend_name = \"ibm_torino\" # Still a good general choice if available and supports N_QUBITS\n",
    "        backend = service.backend(backend_name)\n",
    "\n",
    "        if backend:\n",
    "            print(f\"Selected backend: {backend.name} (Qubits: {backend.num_qubits})\")\n",
    "\n",
    "            # Check if backend supports the number of qubits\n",
    "            if N_QUBITS > backend.num_qubits:\n",
    "                print(f\"Error: Chosen backend {backend.name} only has {backend.num_qubits} qubits, but your circuit requires {N_QUBITS} qubits.\")\n",
    "                print(\"Please choose a backend with enough qubits or reduce N_QUBITS.\")\n",
    "                raise ValueError(\"Not enough qubits on selected backend.\")\n",
    "\n",
    "            print(f\"\\nTranspiling circuit for {backend.name}...\")\n",
    "            transpiled_qc_hardware = transpile(sycamore_qc_measured, backend, optimization_level=3)\n",
    "            print(\"Transpilation complete.\")\n",
    "            print(f\"Estimated circuit depth after transpilation: {transpiled_qc_hardware.depth()}\")\n",
    "            print(f\"Estimated number of gates after transpilation: {transpiled_qc_hardware.size()}\")\n",
    "\n",
    "            print(\"\\nSubmitting job to IBM Quantum hardware in JOB MODE...\")\n",
    "            \n",
    "            # --- CRITICAL CHANGE: Instantiate Sampler directly for Job Mode ---\n",
    "            sampler = Sampler(service=service, backend=backend) # Pass service and backend directly here\n",
    "            \n",
    "            # Set sampler options (these are options for the sampler, not the backend directly)\n",
    "            sampler.options.dynamical_decoupling.enable = True\n",
    "            sampler.options.dynamical_decoupling.sequence_type = \"XY4\"\n",
    "            sampler.options.shots = NUM_SHOTS \n",
    "\n",
    "            print(f\"DEBUG FINAL CHECK: backend type: {type(backend)}\")\n",
    "            print(f\"DEBUG FINAL CHECK: backend name: {backend.name}\")\n",
    "            print(f\"DEBUG FINAL CHECK: Sampler instance: {sampler}\")\n",
    "            print(f\"DEBUG FINAL CHECK: Transpiled circuit: {transpiled_qc_hardware}\")\n",
    "            print(f\"DEBUG FINAL CHECK: Sampler Options Shots: {sampler.options.shots}\")\n",
    "\n",
    "            # Run the circuit - this will submit a single job\n",
    "            job_hardware = sampler.run([transpiled_qc_hardware])\n",
    "\n",
    "            print(f\"Job ID: {job_hardware.job_id}\")\n",
    "            print(\"Waiting for job to complete (this may take a while, depending on queue)...\")\n",
    "\n",
    "            hardware_result = job_hardware.result()\n",
    "\n",
    "            # --- CRITICAL DEBUG PRINTS ---\n",
    "            print(f\"DEBUG: Type of hardware_result: {type(hardware_result)}\")\n",
    "            print(f\"DEBUG: Attributes of hardware_result: {dir(hardware_result)}\") \n",
    "            # --- END DEBUG PRINTS ---\n",
    "\n",
    "            # --- ACCESS RESULTS (still using _pub_results for PrimitiveResult) ---\n",
    "            if hasattr(hardware_result, '_pub_results') and len(hardware_result._pub_results) > 0:\n",
    "                first_result_data = hardware_result._pub_results[0]\n",
    "                print(f\"DEBUG: Type of first_result_data (from _pub_results[0]): {type(first_result_data)}\")\n",
    "                print(f\"DEBUG: Attributes of first_result_data: {dir(first_result_data)}\")\n",
    "\n",
    "                if hasattr(first_result_data, 'quasi_distribution'):\n",
    "                    quasi_dist = first_result_data.quasi_distribution\n",
    "                    print(\"DEBUG: Successfully accessed quasi_distribution via _pub_results[0].quasi_distribution\")\n",
    "                elif hasattr(first_result_data, 'data') and hasattr(first_result_data.data, 'quasi_distribution'):\n",
    "                    quasi_dist = first_result_data.data.quasi_distribution\n",
    "                    print(\"DEBUG: Successfully accessed quasi_distribution via _pub_results[0].data.quasi_distribution\")\n",
    "                else:\n",
    "                    raise AttributeError(f\"Result data object has no 'quasi_distribution' attribute. Found attributes: {dir(first_result_data)}\")\n",
    "            else:\n",
    "                raise AttributeError(f\"'PrimitiveResult' object has no '_pub_results' or it's empty.\")\n",
    "\n",
    "            counts_hardware = {}\n",
    "            import numpy as np\n",
    "\n",
    "            raw_probs = quasi_dist.binary_probabilities()\n",
    "            bitstrings = []\n",
    "            probs = []\n",
    "\n",
    "            for bitstring_int, prob in raw_probs.items():\n",
    "                if prob <= 0:\n",
    "                    continue\n",
    "                bitstring = bin(bitstring_int)[2:].zfill(N_QUBITS)[::-1]\n",
    "                bitstrings.append(bitstring)\n",
    "                probs.append(prob)\n",
    "\n",
    "            probs = np.array(probs)\n",
    "            probs /= np.sum(probs)\n",
    "\n",
    "            samples = np.random.choice(bitstrings, size=NUM_SHOTS, p=probs)\n",
    "\n",
    "            from collections import Counter\n",
    "            counts_hardware = dict(Counter(samples))\n",
    "\n",
    "            print(\"Hardware execution complete.\")\n",
    "            print(f\"Hardware Counts (first 5): {dict(list(counts_hardware.items())[:5])}...\")\n",
    "\n",
    "            xeb_hardware = calculate_xeb_fidelity(ideal_probabilities, counts_hardware, NUM_SHOTS)\n",
    "            print(f\"\\n--- Cross-Entropy Benchmarking (XEB) Fidelity (IBM Quantum Hardware) ---\")\n",
    "            print(f\"XEB Fidelity (IBM Quantum Hardware): {xeb_hardware:.4f}\")\n",
    "\n",
    "        else:\n",
    "            print(\"No suitable real quantum computers found. Please check N_QUBITS or try again later.\")\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"\\nError encountered during IBM Quantum hardware execution: {e}\")\n",
    "        print(\"Please ensure your IBM Quantum API token is saved correctly and you have internet access.\")\n",
    "        print(\"Proceeding with only local simulation results.\")\n",
    "print(\"\\n--- Experiment Summary ---\")\n",
    "print(f\"Configured Qubits: {N_QUBITS}\")\n",
    "print(f\"Configured Depth: {DEPTH}\")\n",
    "print(f\"XEB Fidelity (Noisy Simulator): {xeb_noisy_sim:.4f}\")"
   ]
  }
