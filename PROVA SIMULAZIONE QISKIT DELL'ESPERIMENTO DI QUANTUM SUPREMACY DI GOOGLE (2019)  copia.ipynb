    "def draw_circuit_graph(qc: QuantumCircuit, title=\"Quantum Circuit Graph\"):\n",
    "    \"\"\"\n",
    "    Draws a simplified graph of qubit connectivity and gate operations.\n",
    "    \"\"\"\n",
    "    G = nx.Graph()\n",
    "    for i in range(qc.num_qubits):\n",
    "        G.add_node(f\"q[{i}]\")\n",
    "\n",
    "    for inst, qargs, _ in qc.data:\n",
    "        if len(qargs) == 2:  # Two-qubit gate\n",
    "            a = qargs[0]\n",
    "            b = qargs[1]\n",
    "            G.add_edge(f\"q[{a}]\", f\"q[{b}]\", label=inst.name)\n",
    "\n",
    "    pos = nx.circular_layout(G)\n",
    "    plt.figure(figsize=(6, 6))\n",
    "    nx.draw(G, pos, with_labels=True, node_size=800, font_weight='bold', node_color='lightblue')\n",
    "    edge_labels = nx.get_edge_attributes(G, 'label')\n",
    "    nx.draw_networkx_edge_labels(G, pos, edge_labels=edge_labels)\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
